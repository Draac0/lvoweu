{
  "openapi": "3.1.0",
  "info": {
    "title": "Wind Forecast API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/actuals": {
      "get": {
        "summary": "Actuals",
        "description": "Half-hourly actual wind generation, optionally limited to start <= start_time < end.",
        "operationId": "actuals_api_v1_actuals_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActualPoint"
                  },
                  "title": "Response Actuals Api V1 Actuals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy/summary": {
      "get": {
        "summary": "Accuracy Summary",
        "description": "Headline accuracy of the forecasts available at the cutoff, over all hours.",
        "operationId": "accuracy_summary_api_v1_accuracy_summary_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "time",
              "description": "Market (UK) local time on the day before delivery: the auction deadline",
              "default": "09:00:00",
              "title": "Cutoff"
            },
            "description": "Market (UK) local time on the day before delivery: the auction deadline"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy/distribution": {
      "get": {
        "summary": "Accuracy Distribution",
        "description": "Histogram of errors, and the share of hours still short for each safety margin.",
        "operationId": "accuracy_distribution_api_v1_accuracy_distribution_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "time",
              "description": "Market (UK) local time on the day before delivery: the auction deadline",
              "default": "09:00:00",
              "title": "Cutoff"
            },
            "description": "Market (UK) local time on the day before delivery: the auction deadline"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDistribution"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/days": {
      "get": {
        "summary": "Days",
        "description": "Every delivery day with its typical miss (mean absolute error).",
        "operationId": "days_api_v1_days_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "time",
              "description": "Market (UK) local time on the day before delivery: the auction deadline",
              "default": "09:00:00",
              "title": "Cutoff"
            },
            "description": "Market (UK) local time on the day before delivery: the auction deadline"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DaySummary"
                  },
                  "title": "Response Days Api V1 Days Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/days/{day}": {
      "get": {
        "summary": "Day Detail",
        "description": "One market (UK) day: each hour's forecast at the cutoff vs actual, and all actuals.",
        "operationId": "day_detail_api_v1_days__day__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "day",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Day"
            }
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "time",
              "description": "Market (UK) local time on the day before delivery: the auction deadline",
              "default": "09:00:00",
              "title": "Cutoff"
            },
            "description": "Market (UK) local time on the day before delivery: the auction deadline"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forecasts": {
      "get": {
        "summary": "Forecast History",
        "description": "Every forecast ever published for one target hour, oldest first.",
        "operationId": "forecast_history_api_v1_forecasts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start Time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastHistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy/by-horizon": {
      "get": {
        "summary": "Accuracy By Horizon",
        "description": "Mean absolute error of all forecasts, grouped by how far ahead they were made.",
        "operationId": "accuracy_by_horizon_api_v1_accuracy_by_horizon_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HorizonBucket"
                  },
                  "type": "array",
                  "title": "Response Accuracy By Horizon Api V1 Accuracy By Horizon Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActualPoint": {
        "properties": {
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "generation_mw": {
            "type": "number",
            "title": "Generation Mw"
          }
        },
        "type": "object",
        "required": [
          "start_time",
          "generation_mw"
        ],
        "title": "ActualPoint"
      },
      "DayDetail": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "mae": {
            "type": "number",
            "title": "Mae"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/DecisionHour"
            },
            "type": "array",
            "title": "Hours"
          },
          "actuals": {
            "items": {
              "$ref": "#/components/schemas/ActualPoint"
            },
            "type": "array",
            "title": "Actuals"
          }
        },
        "type": "object",
        "required": [
          "date",
          "mae",
          "hours",
          "actuals"
        ],
        "title": "DayDetail",
        "description": "One market (UK) delivery day: hourly forecasts vs actuals, plus half-hourly actuals."
      },
      "DaySummary": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "mae": {
            "type": "number",
            "title": "Mae"
          }
        },
        "type": "object",
        "required": [
          "date",
          "mae"
        ],
        "title": "DaySummary"
      },
      "DecisionHour": {
        "properties": {
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "publish_time": {
            "type": "string",
            "format": "date-time",
            "title": "Publish Time"
          },
          "horizon_h": {
            "type": "number",
            "title": "Horizon H"
          },
          "forecast_mw": {
            "type": "number",
            "title": "Forecast Mw"
          },
          "actual_mw": {
            "type": "number",
            "title": "Actual Mw"
          },
          "error_mw": {
            "type": "number",
            "title": "Error Mw"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          }
        },
        "type": "object",
        "required": [
          "start_time",
          "publish_time",
          "horizon_h",
          "forecast_mw",
          "actual_mw",
          "error_mw",
          "stale"
        ],
        "title": "DecisionHour",
        "description": "One hour: the forecast available at the cutoff, what actually happened, and the miss."
      },
      "ErrorDistribution": {
        "properties": {
          "bins": {
            "items": {
              "$ref": "#/components/schemas/HistogramBin"
            },
            "type": "array",
            "title": "Bins"
          },
          "shortfall": {
            "items": {
              "$ref": "#/components/schemas/ShortfallPoint"
            },
            "type": "array",
            "title": "Shortfall"
          }
        },
        "type": "object",
        "required": [
          "bins",
          "shortfall"
        ],
        "title": "ErrorDistribution"
      },
      "ErrorSummary": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "mae": {
            "type": "number",
            "title": "Mae"
          },
          "bias": {
            "type": "number",
            "title": "Bias"
          },
          "p10": {
            "type": "number",
            "title": "P10"
          },
          "p50": {
            "type": "number",
            "title": "P50"
          },
          "p90": {
            "type": "number",
            "title": "P90"
          }
        },
        "type": "object",
        "required": [
          "count",
          "mae",
          "bias",
          "p10",
          "p50",
          "p90"
        ],
        "title": "ErrorSummary",
        "description": "Error = forecast - actual. 80% of errors fall between p10 and p90."
      },
      "ForecastHistory": {
        "properties": {
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "actual_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Mw"
          },
          "forecasts": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array",
            "title": "Forecasts"
          }
        },
        "type": "object",
        "required": [
          "start_time",
          "actual_mw",
          "forecasts"
        ],
        "title": "ForecastHistory"
      },
      "ForecastPoint": {
        "properties": {
          "publish_time": {
            "type": "string",
            "format": "date-time",
            "title": "Publish Time"
          },
          "horizon_h": {
            "type": "number",
            "title": "Horizon H"
          },
          "forecast_mw": {
            "type": "number",
            "title": "Forecast Mw"
          }
        },
        "type": "object",
        "required": [
          "publish_time",
          "horizon_h",
          "forecast_mw"
        ],
        "title": "ForecastPoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "actual_rows": {
            "type": "integer",
            "title": "Actual Rows"
          },
          "forecast_rows": {
            "type": "integer",
            "title": "Forecast Rows"
          }
        },
        "type": "object",
        "required": [
          "status",
          "actual_rows",
          "forecast_rows"
        ],
        "title": "Health"
      },
      "HistogramBin": {
        "properties": {
          "from_mw": {
            "type": "number",
            "title": "From Mw"
          },
          "to_mw": {
            "type": "number",
            "title": "To Mw"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "from_mw",
          "to_mw",
          "count"
        ],
        "title": "HistogramBin"
      },
      "HorizonBucket": {
        "properties": {
          "from_h": {
            "type": "number",
            "title": "From H"
          },
          "to_h": {
            "type": "number",
            "title": "To H"
          },
          "mae": {
            "type": "number",
            "title": "Mae"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "from_h",
          "to_h",
          "mae",
          "count"
        ],
        "title": "HorizonBucket"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ShortfallPoint": {
        "properties": {
          "margin_mw": {
            "type": "number",
            "title": "Margin Mw"
          },
          "share_short": {
            "type": "number",
            "title": "Share Short"
          }
        },
        "type": "object",
        "required": [
          "margin_mw",
          "share_short"
        ],
        "title": "ShortfallPoint",
        "description": "Planning for `margin_mw` less wind than forecast, the share of hours still short."
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_at"
        ],
        "title": "Token"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
